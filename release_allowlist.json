{
  "root_files": [
    ".gitignore",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE-CANDIDATE.txt",
    "LICENSE-STATUS.md",
    "pyproject.toml",
    "MANIFEST.in",
    "release_allowlist.json",
    "LICENSE"
  ],
  "directories": {
    ".github/workflows": [
      ".yml",
      ".yaml"
    ],
    "docs": [
      ".md"
    ],
    "examples/synthetic": [
      ".json"
    ],
    "litsearch": [
      ".py",
      ".json"
    ],
    "litsearch_zotero": [
      ".py"
    ],
    "scripts": [
      ".py"
    ],
    "tests": [
      ".py"
    ]
  },
  "forbidden_parts": [
    ".git",
    ".validation",
    "build",
    "dist",
    "tmp",
    "__pycache__",
    "egg-info"
